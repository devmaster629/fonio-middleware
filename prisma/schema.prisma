generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingStatus {
  LIVE
  DRAFT
  HIDDEN
  UNKNOWN
}

enum AvailabilityMode {
  PARENT_ONLY
  CHILDREN_ONLY
  BOTH
}

enum RequestType {
  ADD_GUEST
  ADD_PET
  CANCELLATION
  MODIFICATION
  EARLY_CHECKIN
  LATE_CHECKOUT
  RESERVATION_QUESTION
  OTHER
}

enum RequestStatus {
  PENDING
  AUTO_APPROVED
  FORWARDED
  REJECTED
  COMPLETED
}

enum ApprovalMode {
  AUTO
  MANUAL
  DENY
}

enum AdminRole {
  VIEWER
  EDITOR
  BACK_OFFICE
  ADMIN
  SUPER_ADMIN
}

/// Capability keys used by PermissionsGuard and the role-checkbox UI.
enum AdminPermission {
  DASHBOARD_VIEW
  LISTINGS_VIEW
  LISTINGS_EDIT
  GROUPS_VIEW
  RESERVATIONS_VIEW
  RESERVATIONS_VIEW_PII
  CONVERSATIONS_VIEW
  CONVERSATIONS_MANAGE
  RULES_VIEW
  RULES_EDIT
  RULES_DELETE
  REQUESTS_VIEW
  REQUESTS_MANAGE
  PAYMENTS_VIEW
  PAYMENTS_REVIEW
  PAYMENTS_ADMIN
  LOGS_VIEW
  LOG_SETTINGS_EDIT
  FONIO_ACTIVITY_VIEW
  FONIO_SETUP_VIEW
  USERS_MANAGE
  SYNC_RUN
  SYNC_SETTINGS_EDIT
  WEBHOOKS_MANAGE
  ROLE_PERMISSIONS_MANAGE
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  SECURITY
}

enum ExternalPaymentSource {
  QONTO
  PAYPAL
  MANUAL
}

enum ExternalPaymentStatus {
  RECEIVED
  PENDING_REVIEW
  AUTO_APPLIED
  MANUALLY_APPLIED
  SKIPPED
  FAILED
}

enum PaymentMatchDecision {
  UNAMBIGUOUS
  AMBIGUOUS
  NO_MATCH
  BULK_PAYMENT
  REFUND
  PARTIAL_UNCLEAR
  PLATFORM_PAYOUT
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model RolePermission {
  id         String          @id @default(uuid())
  role       AdminRole
  permission AdminPermission
  createdAt  DateTime        @default(now())

  @@unique([role, permission])
  @@index([role])
}

model ListingGroup {
  id               String           @id @default(uuid())
  hostawayParentId Int              @unique
  name             String
  city             String?
  availabilityMode AvailabilityMode @default(BOTH)
  listings         Listing[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Listing {
  id               String         @id @default(uuid())
  hostawayId       Int            @unique
  name             String
  city             String?
  region           String?
  personCapacity   Int            @default(1)
  bedroomsNumber   Int?
  roomType         String?
  petsAllowed      Boolean        @default(false)
  status           ListingStatus  @default(UNKNOWN)
  isBookable       Boolean        @default(true)
  listingGroupId   String?
  listingGroup     ListingGroup?  @relation(fields: [listingGroupId], references: [id])
  parentHostawayId Int?
  tags             String[]
  aliases          String[]       @default([])
  rawMetadata      Json?
  calendarDays     CalendarDay[]
  reservations     Reservation[]
  approvalRules    ApprovalRule[]
  check24Mapping   Check24PropertyMapping?
  lastSyncedAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([city])
  @@index([status, isBookable])
  @@index([listingGroupId])
}

/// Hostaway listing ↔ CHECK24 Supply API property mapping
model Check24PropertyMapping {
  id                 String    @id @default(uuid())
  listingId          String    @unique
  listing            Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  check24PropertyId  String    @unique
  enabled            Boolean   @default(true)
  contentSyncedAt    DateTime?
  availabilitySyncedAt DateTime?
  ratesSyncedAt      DateTime?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([enabled])
}

/// Inbound CHECK24 booking processed into Hostaway
model Check24Booking {
  id                     String    @id @default(uuid())
  check24BookingId       String    @unique
  check24PropertyId      String
  status                 String
  hostawayReservationId  Int?
  rawPayload             Json?
  lastError              String?
  processedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status])
  @@index([check24PropertyId])
}

model CalendarDay {
  id          String   @id @default(uuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  isAvailable Boolean  @default(true)
  minNights   Int?
  price       Float?
  syncedAt    DateTime @default(now())

  @@unique([listingId, date])
  @@index([date, isAvailable])
}

model Reservation {
  id                 String          @id @default(uuid())
  hostawayId         Int             @unique
  listingId          String
  listing            Listing         @relation(fields: [listingId], references: [id])
  arrivalDate        DateTime        @db.Date
  departureDate      DateTime        @db.Date
  numberOfGuests     Int
  adults             Int?
  children           Int?
  pets               Int?
  status             String
  guestPhone         String?
  guestEmail         String?
  guestName          String?
  phoneHash          String?
  emailHash          String?
  guestNameMasked    String?
  guestFirstNameHint String?
  totalPrice         Float?
  channelName        String?
  channelId          Int?
  hostNote           String?
  guestNote          String?
  comment            String?
  hostawayConversationId Int?
  paymentBaselinedAt DateTime?
  unpaidReminderSentAt DateTime?
  guestRequests      GuestRequest[]
  notifiedCharges    NotifiedGuestCharge[]
  externalPayments   ExternalPayment[]
  paymentAllocations PaymentAllocation[]
  lastSyncedAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([phoneHash])
  @@index([emailHash])
  @@index([arrivalDate, departureDate])
  @@index([unpaidReminderSentAt, arrivalDate])
}

model NotifiedGuestCharge {
  id                String      @id @default(uuid())
  hostawayChargeId  Int         @unique
  reservationId     String
  reservation       Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amount            Float
  currency          String      @default("EUR")
  inboxPosted       Boolean     @default(false)
  hostawayMessageId Int?
  notifiedAt        DateTime    @default(now())

  @@index([reservationId])
}

model ExternalPayment {
  id                     String                 @id @default(uuid())
  source                 ExternalPaymentSource
  externalId             String
  amount                 Float
  currency               String                 @default("EUR")
  occurredAt             DateTime
  payerName              String?
  payerEmail             String?
  reference              String?
  rawPayload             Json
  status                 ExternalPaymentStatus  @default(RECEIVED)
  matchDecision          PaymentMatchDecision?
  matchScore             Float?
  matchReason            String?
  matchCandidates        Json?
  matchedReservationId   String?
  matchedReservation     Reservation?           @relation(fields: [matchedReservationId], references: [id])
  hostawayChargeId       Int?
  reviewedBy             String?
  reviewedAt             DateTime?
  reviewNote             String?
  error                  String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  allocations            PaymentAllocation[]

  @@unique([source, externalId])
  @@index([status])
  @@index([createdAt])
  @@index([matchedReservationId])
}

model PaymentAllocation {
  id                String          @id @default(uuid())
  externalPaymentId String
  externalPayment   ExternalPayment @relation(fields: [externalPaymentId], references: [id], onDelete: Cascade)
  reservationId     String
  reservation       Reservation     @relation(fields: [reservationId], references: [id])
  amount            Float
  hostawayChargeId  Int?
  note              String?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())

  @@unique([externalPaymentId, reservationId])
  @@index([externalPaymentId])
  @@index([reservationId])
}

model VerificationConfig {
  id                  String   @id @default(uuid())
  name                String   @unique
  requiredFields      String[]
  minMatchCount       Int      @default(2)
  bookingOfferEnabled Boolean  @default(true)
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ApprovalRule {
  id          String       @id @default(uuid())
  listingId   String?
  listing     Listing?     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requestType RequestType
  mode        ApprovalMode @default(MANUAL)
  conditions  Json?
  priority    Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([requestType, isActive])
  @@index([listingId])
}

model GuestRequest {
  id               String        @id @default(uuid())
  reservationId    String?
  reservation      Reservation?  @relation(fields: [reservationId], references: [id])
  requestType      RequestType
  status           RequestStatus @default(PENDING)
  payload          Json
  fonioCallId      String?
  callerPhoneHash  String?
  forwardedToHostaway Boolean    @default(false)
  hostawayMessageId Int?
  resolutionNote   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ApiLog {
  id           String   @id @default(uuid())
  level        LogLevel @default(INFO)
  source       String
  action       String
  method       String?
  path         String?
  statusCode   Int?
  durationMs   Int?
  metadata     Json?
  ipHash       String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@index([source, action])
  @@index([createdAt])
}

model HostawayToken {
  id          String   @id @default(uuid())
  accessToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SyncJob {
  id         String    @id @default(uuid())
  jobType    String
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?
  metadata   Json?
}

model SyncSettings {
  id              String    @id @default("default")
  autoSyncEnabled Boolean   @default(true)
  intervalMinutes Int       @default(30)
  lastAutoSyncAt  DateTime?
  updatedAt       DateTime  @updatedAt
}

model LogSettings {
  id                       String   @id @default("default")
  debugRetentionDays       Int      @default(14)
  operationalRetentionDays Int      @default(30)
  piiRetentionDays         Int      @default(30)
  maxRetentionDays         Int      @default(90)
  debugAutoDelete          Boolean  @default(true)
  operationalAutoDelete    Boolean  @default(true)
  piiAutoDelete            Boolean  @default(true)
  autoPurgeEnabled         Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}
