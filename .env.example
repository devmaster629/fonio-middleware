# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
PRODUCTION_URL=https://vermietung.brainions.digital

# Database
DATABASE_URL=postgresql://vermietung:vermietung@localhost:5432/vermietung?schema=public

# Redis (reserved)
REDIS_URL=redis://localhost:6379

# Hostaway Public API (server-side only — never expose to frontend)
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_SECRET=
HOSTAWAY_API_BASE_URL=https://api.hostaway.com/v1

# fonio.ai middleware API key (server-side only)
FONIO_API_KEY=

# Admin JWT (change before production)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Initial admin (created on first boot if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Log retention (days) — GDPR-conscious audit logs (see docs/SECURITY.md)
LOG_RETENTION_DEBUG_DAYS=14
LOG_RETENTION_OPERATIONAL_DAYS=30
LOG_RETENTION_PII_DAYS=30
LOG_RETENTION_MAX_DAYS=90

# Production security
# FORCE_HTTPS=true
# SWAGGER_ENABLED=true

# Sync
SYNC_ENABLED=true

# Hostaway webhook basic auth (recommended in production)
HOSTAWAY_WEBHOOK_USERNAME=
HOSTAWAY_WEBHOOK_PASSWORD=
# Email Hostaway uses when unified webhook delivery fails (Hostaway dashboard / API)
HOSTAWAY_WEBHOOK_ALERT_EMAIL=technik@brainions.de

# Payment reconciliation (Qonto / PayPal)
QONTO_ENABLED=false
# Qonto API key login (Kennung) + secret from Integrations → API key
QONTO_LOGIN=
QONTO_SECRET_KEY=
QONTO_CLIENT_ID=
QONTO_CLIENT_SECRET=
QONTO_ORGANIZATION_SLUG=
QONTO_WEBHOOK_SECRET=
QONTO_POLL_LOOKBACK_HOURS=72

PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=live

# Auto-apply only when match score >= this (default 85)
PAYMENT_AUTO_MATCH_MIN_SCORE=85

# Payer-name patterns for channel payouts that are auto-skipped (comma separated).
# Add ",booking.com" once the client confirms Payments by Booking.com is active.
PAYMENT_PLATFORM_PAYOUT_SENDERS=airbnb

# Middleware-side email alerts when a payment is applied in Hostaway.
# one.com example: host send.one.com, port 587, secure false
PAYMENT_ALERTS_ENABLED=true
PAYMENT_ALERT_TO=vermietung@brainions.de
PAYMENT_ALERT_FROM=technik@ichweissdas.net
PAYMENT_ALERT_SMTP_HOST=send.one.com
PAYMENT_ALERT_SMTP_PORT=587
PAYMENT_ALERT_SMTP_SECURE=false
PAYMENT_ALERT_SMTP_USER=technik@ichweissdas.net
PAYMENT_ALERT_SMTP_PASS=
# Immediate email when a payment cannot be auto-matched, plus daily digests
# at 19:00 and 08:00 Europe/Berlin while unmatched payments remain.

# Performance tuning (optional — see docs/DEPLOYMENT.md)
# CONVERSATION_BACKFILL_ON_SYNC=true

# CHECK24 Ferienwohnungen Supply API v2 (see docs/CHECK24.md)
CHECK24_ENABLED=false
CHECK24_API_TOKEN=
CHECK24_API_BASE_URL=https://supplyapistaging.ferienwohnung.check24-test.de/api/v2
CHECK24_TERMS_URL=https://brainions.digital/agb
CHECK24_HOST_TYPE=professional
CHECK24_PARTNER_DISPLAY_NAME=brainions Vermietung
CHECK24_CONTACT_EMAIL=
CHECK24_CONTACT_PHONE=
CHECK24_HOST_NAME=brainions Vermietung
CHECK24_TEST_PROPERTY=true
CHECK24_ENQUIRY_ONLY=false
CHECK24_AUTO_ACCEPT_ENQUIRY=true
CHECK24_HOSTAWAY_CHANNEL_ID=2000
CHECK24_PROPERTY_ID_PREFIX=ha
CHECK24_CANCEL_FREE_DAYS=14
CHECK24_VAT_PERCENT=0
CHECK24_WEBHOOK_USERNAME=
CHECK24_WEBHOOK_PASSWORD=
CHECK24_AUTO_SYNC=true
CHECK24_AUTO_SYNC_CONTENT=false
CHECK24_SYNC_INTERVAL_MINUTES=30
CHECK24_BOOKING_POLL_INTERVAL_MINUTES=10
CHECK24_SYNC_CONCURRENCY=2
CHECK24_SYNC_DELAY_MS=200
